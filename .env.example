# ---------------------------------------------------------------------------
# AeroTAXI — copy to .env and fill in what you need.
# Everything here is optional for local development: without Stripe keys the
# checkout runs in demo mode, and without SMTP settings emails are logged
# to the console instead of being sent.
# ---------------------------------------------------------------------------

NODE_ENV=development

# API ----------------------------------------------------------------------
API_PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database (Postgres) ------------------------------------------------------
# Local:  postgresql://postgres:postgres@localhost:5432/aerotaxi
# Vercel: injected automatically by the Neon/Postgres integration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aerotaxi
# Connections per instance (1 on serverless, a small pool on a real server).
# DATABASE_POOL_MAX=5

# Admin session ------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
SESSION_DAYS=7
REMEMBER_DAYS=30

# Seeded admin account -----------------------------------------------------
# Only read by `npm run db:seed`, and only when no admin exists yet. Set a
# real password here before seeding a deployed database; it is never needed
# by the running server, so it does not belong in your hosting env vars.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@aerotaxi.com
SEED_ADMIN_PASSWORD=change-me-before-seeding

# Stripe -------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Mail (SMTP) --------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=supportaerotaxi@gmail.com
MAIL_FROM_NAME=AeroTAXI
ADMIN_EMAILS=supportaerotaxi@gmail.com

# Flight lookup (optional, falls back to an offline airline directory) -----
AVIATIONSTACK_API_KEY=
