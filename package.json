{
  "name": "aerotaxi-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade UK airport-transfer booking platform: React 18 + TypeScript front end, Express API, Turso (libSQL), Stripe payments and a full admin back office.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "db:seed": "tsx server/src/seed.ts",
    "db:reset": "tsx server/src/seed.ts --fresh",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "tsc -b",
    "icons": "python scripts/generate-icons.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@libsql/client": "^0.14.0",
    "@stripe/react-stripe-js": "^2.8.1",
    "@stripe/stripe-js": "^4.9.0",
    "@tanstack/react-query": "^5.59.16",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.27.0",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.8.6",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "license": "MIT",
  "homepage": "https://aerotaxi-uk.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/AreeshaKhan25/AeroTaxi-React.git"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "express",
    "turso",
    "libsql",
    "stripe",
    "tailwindcss",
    "booking-system",
    "airport-transfers",
    "vercel"
  ]
}
